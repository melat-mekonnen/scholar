# Staging / production template — copy values into your host secrets (Railway, Vercel, Fly, etc.)
# Do NOT commit a filled copy. Keep developing locally with root .env (localhost URLs).

# --- Public URLs (required for staging) ---
STAGING_APP_URL=https://app.your-domain.com
STAGING_API_URL=https://api.your-domain.com

# API service (set on backend host)
NODE_ENV=production
PORT=4000
FRONTEND_APP_URL=https://app.your-domain.com
GOOGLE_REDIRECT_URI=https://api.your-domain.com/auth/google/callback

# Supabase session pooler (port 6543), password URL-encoded, sslmode=require
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require

JWT_SECRET=generate_with_crypto_randomBytes_48

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Web service (set at BUILD time on frontend host) ---
# Option A — same domain (reverse proxy / Docker): browser hits /api on app host
# BACKEND_URL=https://api.your-domain.com
# NEXT_PUBLIC_API_BASE_URL=

# Option B — split origins (Vercel web + Railway API):
# NEXT_PUBLIC_API_BASE_URL=https://api.your-domain.com
# BACKEND_URL=

# --- Milestone 4: production runtime ---
# Persistent uploads (mount volume to this path on Railway/Fly/VPS)
UPLOADS_ROOT=/app/uploads

# Background cron inside API process — use one replica, or set false and run jobs elsewhere
BACKGROUND_JOBS_ENABLED=true

# Email jobs require SMTP_* — if SMTP not ready, set both to false
DEADLINE_REMINDER_ENABLED=false
APPLY_FOLLOWUP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

INGESTION_ENABLED=false
CHAPA_CALLBACK_URL=https://api.your-domain.com/api/billing/webhooks/chapa
CHAPA_RETURN_URL=https://app.your-domain.com/settings/subscription?billing=success
STRIPE_SUCCESS_URL=https://app.your-domain.com/settings/subscription?billing=success
STRIPE_CANCEL_URL=https://app.your-domain.com/settings/subscription?billing=cancel

# Smoke test after deploy:
#   STAGING_API_URL=https://api.your-domain.com npm run smoke:api --prefix scholar-backend
