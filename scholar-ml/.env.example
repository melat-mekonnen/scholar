# ---------------------------------------------------------------------------
# Scholar-ML — environment (copy to .env, never commit .env)
# ---------------------------------------------------------------------------

# Postgres read-only user recommended for export scripts (Milestone 1+)
# Example local: postgresql://readonly_user:password@localhost:5432/scholar?sslmode=disable
DATABASE_URL=postgres://postgres:12345678@localhost:5432/scholarship_db

# Ollama (Milestone 7+) — default local install
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# FastAPI service (Milestone 8+)
SCHOLAR_ML_HOST=0.0.0.0
SCHOLAR_ML_PORT=8020

# Embedding model — must match src/config.py (do not change without re-indexing)
# SCHOLAR_ML_EMBEDDING_MODEL=all-MiniLM-L6-v2
