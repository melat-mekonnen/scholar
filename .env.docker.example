# Copy to `.env` in this directory and fill values before: docker compose up --build

# --- Required (backend) ---
# Host machine (npm run seed:test-roles, local backend): published DB port on localhost
DATABASE_URL=postgres://postgres:postgres@localhost:55432/scholarship_db?sslmode=disable

# Docker API container only — do not use localhost here (api runs inside compose network)
DOCKER_DATABASE_URL=postgres://postgres:postgres@db:5432/scholarship_db?sslmode=disable
JWT_SECRET=docker-dev-jwt-secret-change-me

# Google OAuth — replace with real values for sign-in; placeholders work for browse/ingest
GOOGLE_CLIENT_ID=docker-dev-not-configured
GOOGLE_CLIENT_SECRET=docker-dev-not-configured

# Public URL of the Next.js app (browser origin) — used for CORS and post-OAuth redirect
FRONTEND_APP_URL=http://localhost:3000

# Must match a URI registered in Google Cloud Console (typically the API callback URL)
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# --- Optional ports (docker-compose) ---
# API_PORT=4000
# WEB_PORT=3000
# Use 55432 if local Postgres already uses 5432
DB_PORT=55432

# --- Containerized Postgres defaults ---
POSTGRES_DB=scholarship_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Optional ---
# AI_SERVICE_URL=http://host.docker.internal:8010
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# INGESTION_ENABLED=true
# INGEST_DAAD_ENABLED=true
# INGEST_ERASMUS_ENABLED=true
# INGEST_FULBRIGHT_ENABLED=true
# INGEST_CHEVENING_ENABLED=true
# INGEST_COMMONWEALTH_ENABLED=true
# INGEST_FASTWEB_ENABLED=false
# INGEST_AUSTRALIA_AWARDS_ENABLED=true
# INGEST_MASTERCARD_FOUNDATION_ENABLED=true
# INGEST_AFRICAN_MINISTRIES_ENABLED=true
# INGEST_AFRICAN_UNIVERSITIES_ENABLED=true
# INGEST_AFRICAN_AGGREGATORS_ENABLED=true
# INGEST_AFRICAN_RESEARCH_ENABLED=true
# INGEST_US_AGGREGATOR_DISCOVERY_ENABLED=false
# INGEST_PIPELINE_MODE=staging
# INGEST_DEDUP_MODE=merge

# OpenRouter (optional — template descriptions work without a key)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-4o-mini
# SCHOLAR_ML_CHAT_URL=http://host.docker.internal:8020
# AI_DESCRIPTION_REFINE_ENABLED=false
# AI_TRANSLATION_ENABLED=false

# Stripe (optional for billing in docker)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID_PRO_MONTHLY=price_...
# STRIPE_SUCCESS_URL=http://localhost:3000/settings/subscription?billing=success
# STRIPE_CANCEL_URL=http://localhost:3000/settings/subscription?billing=cancel

# Chapa (optional for ETB billing in docker)
# CHAPA_SECRET_KEY=CHASECK_TEST-...
# CHAPA_PRO_AMOUNT_ETB=149
# CHAPA_PRO_DAYS=30
# For local dev, callback can be left empty; public HTTPS URL required for actual webhook callbacks.
# CHAPA_CALLBACK_URL=
# CHAPA_RETURN_URL=http://localhost:3000/settings/subscription?billing=success
