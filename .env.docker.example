# Copy to `.env` in this directory and fill values before: docker compose up --build

# --- Required (backend) ---
# Leave DATABASE_URL empty to use the containerized Postgres defaults below,
# or set it explicitly if you want to use an external database.
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DB?sslmode=require
JWT_SECRET=use_a_long_random_string

# Google OAuth (same app as local dev; redirect must hit the API URL the browser can reach)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public URL of the Next.js app (browser origin) — used for CORS and post-OAuth redirect
FRONTEND_APP_URL=http://localhost:3000

# Must match a URI registered in Google Cloud Console (typically the API callback URL)
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# --- Optional ports (docker-compose) ---
# API_PORT=4000
# WEB_PORT=3000
# DB_PORT=5432

# --- Containerized Postgres defaults ---
POSTGRES_DB=scholarship_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# --- Optional ---
# AI_SERVICE_URL=http://host.docker.internal:8010
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# INGESTION_ENABLED=false
# INGEST_DAAD_ENABLED=false
