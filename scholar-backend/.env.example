PORT=4000
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DB?sslmode=require
JWT_SECRET=replace_me_with_random_string
FRONTEND_APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=replace_me
GOOGLE_CLIENT_SECRET=replace_me
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback
AI_SERVICE_URL=http://127.0.0.1:8010
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Scholar Portal <your_email@gmail.com>"
INGESTION_ENABLED=false
INGEST_DAAD_ENABLED=false

# AI chat subscription (Milestone 1+)
CHAT_FREE_DAILY_LIMIT=3
CHAT_QUOTA_BYPASS_ROLES=admin,owner

# Stripe (Pro subscription — AI chat unlimited)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_PRO_MONTHLY=price_...
STRIPE_SUCCESS_URL=http://localhost:3000/settings/subscription?billing=success
STRIPE_CANCEL_URL=http://localhost:3000/settings/subscription?billing=cancel

# Chapa (ETB — local payments; Telebirr often available on Chapa checkout)
CHAPA_SECRET_KEY=
CHAPA_PRO_AMOUNT_ETB=149
CHAPA_PRO_DAYS=30
# Optional. Must be a public HTTPS URL (Chapa rejects localhost/127.0.0.1).
# Leave empty for local dev — activation uses return_url + POST /api/billing/chapa/confirm.
# CHAPA_CALLBACK_URL=https://your-domain.com/api/billing/webhooks/chapa
CHAPA_RETURN_URL=http://localhost:3000/settings/subscription?billing=success
# Optional: prefill Chapa checkout when the user has a test/.local email
# CHAPA_FALLBACK_EMAIL=you@gmail.com
# Additional ingestion source toggles
INGEST_ERASMUS_ENABLED=false
INGEST_FULBRIGHT_ENABLED=false
INGEST_CHEVENING_ENABLED=false
INGEST_COMMONWEALTH_ENABLED=false
INGEST_FASTWEB_ENABLED=false
INGEST_AUSTRALIA_AWARDS_ENABLED=false
INGEST_MASTERCARD_FOUNDATION_ENABLED=false
INGEST_AFRICAN_MINISTRIES_ENABLED=true
INGEST_AFRICAN_UNIVERSITIES_ENABLED=true
INGEST_AFRICAN_AGGREGATORS_ENABLED=true
INGEST_AFRICAN_RESEARCH_ENABLED=true

# Pipeline: staging (capture all → publish selectively) | direct (legacy)
INGEST_PIPELINE_MODE=staging
# Dedup: merge (enrich existing rows) | strict (skip duplicates)
INGEST_DEDUP_MODE=merge

# OpenRouter — AI description refine + Amharic translation at ingest time
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
AI_DESCRIPTION_REFINE_ENABLED=false
AI_TRANSLATION_ENABLED=false

# Local dev only: wipe `public` schema and reapply db/schema.sql (removes leftover Prisma/other tables)
# CONFIRM_DB_RESET=yes
