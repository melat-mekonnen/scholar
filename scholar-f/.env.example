# Copy to .env.local for local Next.js dev (optional).
# Staging/production: see repo .env.staging.example and docs/DEPLOY.md (Milestone 3).

# Build-time: Express API URL for Next rewrites (/api/* -> backend).
# Leave as default for local dev (scholar-backend on :4000).
# BACKEND_URL=http://127.0.0.1:4000

# Build-time: only when the browser calls the API on another origin (split deploy).
# Leave empty for same-origin proxy (Docker / single-domain).
# NEXT_PUBLIC_API_BASE_URL=https://api.your-domain.com
