"use client"

import { useEffect, useMemo, useState } from "react"
import Link from "next/link"
import { useRouter } from "next/navigation"
import { Search, CheckCircle2, XCircle, ChevronDown } from "lucide-react"

import { apiFetchJson } from "@/lib/api"
import { clearToken } from "@/lib/auth"
import { useToast } from "@/hooks/use-toast"
import { Badge } from "@/components/ui/badge"
import { Button } from "@/components/ui/button"
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card"
import { Input } from "@/components/ui/input"
import {
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from "@/components/ui/table"
import {
  Select,
  SelectContent,
  SelectItem,
  SelectTrigger,
  SelectValue,
} from "@/components/ui/select"

type Candidate = {
  id: string
  url: string
  raw_text?: string
  extracted_data?: {
    title?: string
    deadline?: string
    funding_type?: string
    degree_level?: string
    field_of_study?: string
    country?: string
    requirements?: string[]
    description?: string
    [key: string]: unknown
  }
  score?: number
  status: "pending" | "approved" | "rejected"
  created_at?: string
}

type CandidateResponse = {
  candidates: Candidate[]
}

const statusOptions = ["all", "pending", "approved", "rejected"] as const

function renderStatusBadge(status: Candidate["status"]) {
  switch (status) {
    case "approved":
      return <Badge className="bg-green-600 text-white">Approved</Badge>
    case "rejected":
      return <Badge variant="destructive">Rejected</Badge>
    default:
      return <Badge variant="outline">Pending</Badge>
  }
}

export default function AdminCandidatesPage() {
  const router = useRouter()
  const { toast } = useToast()

  const [candidates, setCandidates] = useState<Candidate[]>([])
  const [statusFilter, setStatusFilter] = useState<(typeof statusOptions)[number]>("pending")
  const [query, setQuery] = useState("")
  const [loading, setLoading] = useState(true)
  const [error, setError] = useState<string | null>(null)
  const [mutatingIds, setMutatingIds] = useState<Record<string, boolean>>({})

  useEffect(() => {
    async function loadCandidates() {
      setLoading(true)
      setError(null)
      const { res, data, errorMessage } = await apiFetchJson<Candidate[]>(
        "/api/admin/candidates",
        { method: "GET" },
      )

      if (res.status === 401 || res.status === 403) {
        clearToken()
        router.replace("/signin")
        return
      }

      if (!res.ok || !data) {
        setError(errorMessage || "Unable to load candidate list")
      } else {
        setCandidates(data)
      }
      setLoading(false)
    }

    loadCandidates()
  }, [router])

  const visibleCandidates = useMemo(() => {
    const normalizedQuery = query.trim().toLowerCase()
    return candidates.filter((candidate) => {
      const matchesStatus = statusFilter === "all" || candidate.status === statusFilter
      const matchesQuery =
        !normalizedQuery ||
        candidate.url.toLowerCase().includes(normalizedQuery) ||
        (candidate.extracted_data?.title ?? "").toLowerCase().includes(normalizedQuery) ||
        candidate.url.toLowerCase().includes(normalizedQuery)
      return matchesStatus && matchesQuery
    })
  }, [candidates, query, statusFilter])

  const isMutating = (id: string) => !!mutatingIds[id]

  async function refreshCandidates() {
    setLoading(true)
    const { res, data } = await apiFetchJson<Candidate[]>("/api/admin/candidates", {
      method: "GET",
    })
    if (res.ok && data) {
      setCandidates(data)
      setError(null)
    }
    setLoading(false)
  }

  async function updateCandidateStatus(id: string, action: "approve" | "reject") {
    setMutatingIds((prev) => ({ ...prev, [id]: true }))
    try {
      const { res, errorMessage } = await apiFetchJson(
        `/api/admin/candidates/${id}/${action}`,
        { method: "PATCH" },
      )

      if (!res.ok) {
        throw new Error(errorMessage || `Failed to ${action} candidate`)
      }

      setCandidates((prev) =>
        prev.map((candidate) =>
          candidate.id === id
            ? { ...candidate, status: action === "approve" ? "approved" : "rejected" }
            : candidate,
        ),
      )

      toast({
        title: action === "approve" ? "Candidate approved" : "Candidate rejected",
        description:
          action === "approve"
            ? "The candidate has been approved and will be available in scholarships."
            : "The candidate has been rejected and removed from pending review.",
      })
    } catch (err) {
      toast({
        title: "Action failed",
        description:
          err instanceof Error ? err.message : "Unable to update candidate status.",
        variant: "destructive",
      })
    } finally {
      setMutatingIds((prev) => ({ ...prev, [id]: false }))
    }
  }

  return (
    <main className="min-h-screen bg-background">
      <div className="mx-auto max-w-6xl px-4 py-8 space-y-6">
        <header className="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <h1 className="text-2xl font-semibold">Candidate Review</h1>
            <p className="mt-1 text-sm text-muted-foreground">
              Review scholarship discovery candidates, inspect AI extraction results, and approve or reject entries.
            </p>
          </div>

          <div className="flex flex-col gap-3 sm:flex-row sm:items-center">
            <Input
              value={query}
              onChange={(event) => setQuery(event.target.value)}
              placeholder="Search by title or URL"
              className="min-w-[260px]"
            />

            <Select value={statusFilter} onValueChange={(value) => setStatusFilter(value as Candidate["status"] | "all")}> 
              <SelectTrigger className="w-44">
                <SelectValue placeholder="Filter status" />
              </SelectTrigger>
              <SelectContent>
                <SelectItem value="all">All</SelectItem>
                <SelectItem value="pending">Pending</SelectItem>
                <SelectItem value="approved">Approved</SelectItem>
                <SelectItem value="rejected">Rejected</SelectItem>
              </SelectContent>
            </Select>

            <Button variant="outline" onClick={refreshCandidates} disabled={loading}>
              Refresh
            </Button>
          </div>
        </header>

        <section className="grid gap-4">
          <Card className="overflow-hidden">
            <CardHeader>
              <CardTitle className="text-base">Candidate summary</CardTitle>
            </CardHeader>
            <CardContent className="grid gap-4 sm:grid-cols-3">
              <div>
                <p className="text-sm text-muted-foreground">Total candidates</p>
                <p className="mt-1 text-xl font-semibold">{candidates.length}</p>
              </div>
              <div>
                <p className="text-sm text-muted-foreground">Pending</p>
                <p className="mt-1 text-xl font-semibold">{candidates.filter((c) => c.status === "pending").length}</p>
              </div>
              <div>
                <p className="text-sm text-muted-foreground">Approved / Rejected</p>
                <p className="mt-1 text-xl font-semibold">
                  {candidates.filter((c) => c.status === "approved").length} / {candidates.filter((c) => c.status === "rejected").length}
                </p>
              </div>
            </CardContent>
          </Card>

          {error ? (
            <div className="rounded-xl border border-red-200 bg-red-50 p-4 text-sm text-red-700">
              {error}
            </div>
          ) : null}

          <div className="hidden md:block">
            <Card>
              <CardContent className="p-0">
                <Table>
                  <TableHeader>
                    <TableRow>
                      <TableHead>Title</TableHead>
                      <TableHead>URL</TableHead>
                      <TableHead>Field</TableHead>
                      <TableHead>Funding</TableHead>
                      <TableHead>Country</TableHead>
                      <TableHead>Deadline</TableHead>
                      <TableHead>AI score</TableHead>
                      <TableHead>Status</TableHead>
                      <TableHead className="text-right">Actions</TableHead>
                    </TableRow>
                  </TableHeader>
                  <TableBody>
                    {loading ? (
                      <TableRow>
                        <TableCell colSpan={9} className="p-6 text-center text-sm text-muted-foreground">
                          Loading candidates...
                        </TableCell>
                      </TableRow>
                    ) : visibleCandidates.length === 0 ? (
                      <TableRow>
                        <TableCell colSpan={9} className="p-6 text-center text-sm text-muted-foreground">
                          No candidates found.
                        </TableCell>
                      </TableRow>
                    ) : (
                      visibleCandidates.map((candidate) => {
                        const extracted = candidate.extracted_data ?? {}
                        const score = candidate.score ?? extracted.ai_confidence ?? null
                        return (
                          <TableRow key={candidate.id}>
                            <TableCell>
                              <div className="font-medium">{extracted.title || "Untitled candidate"}</div>
                              <div className="text-sm text-muted-foreground">
                                {candidate.url.split('://')[1]?.split('/')[0] || candidate.url}
                              </div>
                            </TableCell>
                            <TableCell className="max-w-xs truncate">{candidate.url}</TableCell>
                            <TableCell>{extracted.field_of_study || "—"}</TableCell>
                            <TableCell>{extracted.funding_type || "—"}</TableCell>
                            <TableCell>{extracted.country || "—"}</TableCell>
                            <TableCell>{extracted.deadline || "—"}</TableCell>
                            <TableCell>{score !== null ? `${Math.round(Number(score) * 100)}%` : "N/A"}</TableCell>
                            <TableCell>{renderStatusBadge(candidate.status)}</TableCell>
                            <TableCell className="text-right space-x-2">
                              <details className="inline-block text-left">
                                <summary className="inline-flex cursor-pointer items-center gap-1 text-sm text-primary underline decoration-dotted underline-offset-4">
                                  Details <ChevronDown className="h-3 w-3" />
                                </summary>
                                <div className="mt-3 rounded-lg border border-slate-200 bg-slate-50 p-3 text-sm text-slate-700">
                                  <div className="space-y-2">
                                    <div>
                                      <p className="font-medium">Summary</p>
                                      <p className="text-muted-foreground">{extracted.description || "No summary available."}</p>
                                    </div>
                                    <div>
                                      <p className="font-medium">Requirements</p>
                                      <ul className="list-disc pl-5 text-muted-foreground">
                                        {(Array.isArray(extracted.requirements) && extracted.requirements.length > 0
                                          ? extracted.requirements
                                          : ["No requirements extracted."]
                                        ).map((item, index) => (
                                          <li key={index}>{item}</li>
                                        ))}
                                      </ul>
                                    </div>
                                    <div>
                                      <p className="font-medium">Raw extract</p>
                                      <pre className="max-h-40 overflow-auto rounded-md bg-slate-950 p-2 text-xs text-white">
                                        {JSON.stringify(extracted, null, 2)}
                                      </pre>
                                    </div>
                                  </div>
                                </div>
                              </details>
                            </TableCell>
                          </TableRow>
                        )
                      })
                    )}
                  </TableBody>
                </Table>
              </CardContent>
            </Card>
          </div>

          <div className="space-y-4 md:hidden">
            {loading ? (
              <Card>
                <CardContent>
                  <p className="text-sm text-muted-foreground">Loading candidates...</p>
                </CardContent>
              </Card>
            ) : visibleCandidates.length === 0 ? (
              <Card>
                <CardContent>
                  <p className="text-sm text-muted-foreground">No candidates found.</p>
                </CardContent>
              </Card>
            ) : (
              visibleCandidates.map((candidate) => {
                const extracted = candidate.extracted_data ?? {}
                const score = candidate.score ?? extracted.ai_confidence ?? null
                return (
                  <Card key={candidate.id}>
                    <CardHeader>
                      <CardTitle className="text-base">{extracted.title || "Untitled candidate"}</CardTitle>
                    </CardHeader>
                    <CardContent className="space-y-3">
                      <div className="space-y-1 text-sm text-muted-foreground">
                        <p>{candidate.url}</p>
                        <p>
                          {extracted.field_of_study || "—"} · {extracted.funding_type || "—"} · {extracted.country || "—"}
                        </p>
                        <p>Deadline: {extracted.deadline || "N/A"}</p>
                        <p>AI score: {score !== null ? `${Math.round(Number(score) * 100)}%` : "N/A"}</p>
                        {renderStatusBadge(candidate.status)}
                      </div>

                      <details className="space-y-3 rounded-lg border border-slate-200 bg-slate-50 p-3">
                        <summary className="cursor-pointer font-medium">Review details</summary>
                        <div className="space-y-2 text-sm text-slate-700">
                          <p>{extracted.description || "No summary available."}</p>
                          <div>
                            <p className="font-semibold">Requirements</p>
                            <ul className="list-disc pl-5 text-muted-foreground">
                              {(Array.isArray(extracted.requirements) && extracted.requirements.length > 0
                                ? extracted.requirements
                                : ["No requirements extracted."]
                              ).map((item, index) => (
                                <li key={index}>{item}</li>
                              ))}
                            </ul>
                          </div>
                          <pre className="max-h-40 overflow-auto rounded-md bg-slate-950 p-2 text-xs text-white">
                            {JSON.stringify(extracted, null, 2)}
                          </pre>
                        </div>
                      </details>

                      <div className="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
                        <div className="flex flex-wrap gap-2">
                          <Button
                            size="sm"
                            variant="outline"
                            onClick={() => updateCandidateStatus(candidate.id, "approve")}
                            disabled={isMutating(candidate.id)}
                          >
                            <CheckCircle2 className="mr-2 h-4 w-4" />
                            Approve
                          </Button>
                          <Button
                            size="sm"
                            variant="destructive"
                            onClick={() => updateCandidateStatus(candidate.id, "reject")}
                            disabled={isMutating(candidate.id)}
                          >
                            <XCircle className="mr-2 h-4 w-4" />
                            Reject
                          </Button>
                        </div>
                      </div>
                    </CardContent>
                  </Card>
                )
              }))
          </div>
        </section>
      </div>
    </main>
  )
}
